#include <socket.h>
#include <socket_err.h>

inherit CORE_SOCKET;

int udpPort;
int tcpReceived;
int udpReceived;
int accepted;
int closed;
string tcpBuffer = "";

void on_error(int fd, string message) {
    MASTER_OB->check(0, "socket callback: " + message);
}

void on_accept(int fd) {
    accepted++;
}

void on_close(int fd) {
    closed++;
}

void on_connect(int fd) {
    MASTER_OB->check(send(fd, "tcp-ping") == EESUCCESS, "TCP client sends");
}

void on_server_data(int fd, string message) {
    send(fd, message);
}

void on_client_data(int fd, string message) {
    tcpBuffer += message;
    if (tcpBuffer == "tcp-ping") {
        tcpReceived++;
        close(fd);
    }
}

void on_udp_server(int fd, string message, string addr) {
    string host;
    int port;

    sscanf(addr, "%s %d", host, port);
    send(fd, message, host, port);
}

varargs void on_udp_client(int fd, string message, string addr) {
    if (!addr) {
        // 就绪回调里立即发送，验证绑定早于通知。
        MASTER_OB->check(
            send(fd, "udp-ping", "127.0.0.1", udpPort) == EESUCCESS,
            "UDP ready after bind"
        );
    } else if (message == "udp-ping") {
        udpReceived++;
    }
}

void run() {
    int listener, tcpPort, udpListener, tlsFd;
    string host;

    SocketDnsCache["127.0.0.1"] = "127.0.0.1";
    listener = tcp_server(0, this_object(), "on_accept", "on_error", "on_server_data", "on_close");
    MASTER_OB->check(listener >= 0, "TCP listen");
    if (listener >= 0) {
        sscanf(socket_address(listener, 1), "%s %d", host, tcpPort);
        MASTER_OB->check(tcpPort > 0, "TCP ephemeral port");
        tcp_client(
            "127.0.0.1",
            tcpPort,
            this_object(),
            "on_connect",
            "on_client_data",
            "on_close",
            "on_error"
        );
    }
    udpListener = udp_server(0, this_object(), "on_udp_server", "on_error");
    MASTER_OB->check(udpListener >= 0, "UDP listen");
    if (udpListener >= 0) {
        sscanf(socket_address(udpListener, 1), "%s %d", host, udpPort);
        udp_client("127.0.0.1", udpPort, this_object(), "on_udp_client", "on_error");
    }
    tlsFd = create_socket(STREAM_TLS, "handle_receive_callback", "handle_close_callback");
    MASTER_OB->check(tlsFd >= 0, "generic TLS remains available");
    if (tlsFd >= 0) {
        MASTER_OB->check(
            set_option(tlsFd, SO_TLS_VERIFY_PEER, 1) == EESUCCESS,
            "socket option success contract"
        );
        socket_close(tlsFd);
    }
}

void finish() {
    int fd;

    MASTER_OB->check(accepted == 1, "TCP accept callback");
    MASTER_OB->check(tcpReceived == 1, "TCP accepted connection inherits data callback");
    MASTER_OB->check(closed == 1, "TCP accepted connection inherits close callback");
    MASTER_OB->check(udpReceived == 1, "UDP loopback round trip");
    foreach (fd in keys(get_connections()))
        close(fd);
    MASTER_OB->check(sizeof(get_connections()) == 0, "socket cleanup");
}
