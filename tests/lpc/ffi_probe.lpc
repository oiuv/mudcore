#include <ffi.h>

void check(int ok, string label) {
    MASTER_OB->check(ok, "FFI header: " + label);
}

void run() {
#if efun_defined(ffi_sizeof)
    int width;
    buffer data;
    mixed err;
    mixed *layout;

    width = __ARCH__ == "Microsoft Windows" ? 4 : 8;
    check(ffi_sizeof(FFI_LONG) == width, "native signed long width");
    check(ffi_sizeof(FFI_ULONG) == width, "native unsigned long width");
    check(ffi_sizeof(FFI_INT) == 4 && ffi_sizeof(FFI_UINT) == 4, "native int aliases");
    check(ffi_sizeof(FFI_INT64) == 8 && ffi_sizeof(FFI_UINT64) == 8, "fixed 64-bit types");

    data = allocate_buffer(width);
    err = catch(ffi_write(data, 0, FFI_LONG, -2147483648));
    check(!err, "signed write fits exact native buffer");
    if (!err) check(ffi_read(data, 0, FFI_LONG) == -2147483648, "signed read preserves sign");
    err = catch(ffi_write(data, 0, FFI_ULONG, 4294967295));
    check(!err, "unsigned write fits exact native buffer");
    if (!err) check(ffi_read(data, 0, FFI_ULONG) == 4294967295, "unsigned read preserves high bit");

    data = allocate_buffer(width + 4);
    ffi_write(data, width, FFI_INT32, 0x12345678);
    ffi_write(data, 0, FFI_LONG, -1);
    check(ffi_read(data, width, FFI_INT32) == 0x12345678, "signed write preserves next field");
    ffi_write(data, width, FFI_INT32, 0x12345678);
    ffi_write(data, 0, FFI_ULONG, 4294967295);
    check(ffi_read(data, width, FFI_INT32) == 0x12345678, "unsigned write preserves next field");

    layout = ffi_struct_layout(({ FFI_LONG, FFI_INT }));
    check(layout[0] == width * 2 && layout[1][0] == 0 && layout[1][1] == width,
        "native signed long and int struct layout");
    layout = ffi_struct_layout(({ FFI_ULONG, FFI_INT }));
    check(layout[0] == width * 2 && layout[1][0] == 0 && layout[1][1] == width,
        "native unsigned long and int struct layout");
#else
    debug_message("FFI header regression skipped: driver has no FFI package");
#endif
}
